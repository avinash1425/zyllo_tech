# Browser-safe values only. Secrets (service key, Gemini key) live in
# Supabase Edge Function secrets, never here.
VITE_SITE_URL=https://zyllotech.com
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Google Analytics 4 (public by design; loads only after cookie consent, only on zyllotech.com).
VITE_GA_MEASUREMENT_ID=G-LQYNCZH7K1

# Project Tracker local development needs NO env file: `node scripts/pt-local/start.mjs` starts a private
# local database + API and sets these VITE_ values for its own dev server (see docs/project-tracker/LOCAL_SETUP.md).
# Optional external sign-in for local testing (`--auth-upstream hr-dev`) reads a git-ignored .env.hr.local with
# only a public URL + publishable key:
#   VITE_SUPABASE_PROJECT_ID=<hr dev project ref>
#   VITE_SUPABASE_URL=https://<hr dev project ref>.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Never put service-role / secret keys, database passwords or user passwords in any env file in Git.
