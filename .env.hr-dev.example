# HR DEVELOPMENT configuration for `node scripts/hr-dev/start.mjs`.
#
#   1. Copy this file to .env.hr-dev.local (git-ignored; never commit it).
#   2. Replace the placeholder with the publishable key you were given privately.
#   3. Run: node scripts/hr-dev/start.mjs
#
# Everything starting with VITE_ is shipped to the browser. Only the
# PUBLISHABLE key belongs here. NEVER put a secret / service-role key
# (sb_secret_…) or a database password in this file.
# The launcher refuses to start for the production project.

# Must be exactly the HR development project reference.
HR_DEV_PROJECT_REF=whiclllqgxxqhufkduuo

# HR development API URL (not secret).
VITE_SUPABASE_URL=https://whiclllqgxxqhufkduuo.supabase.co

# HR development PUBLISHABLE key (starts with sb_publishable_). Shared privately.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# --- Maintainers only (applying migrations). Leave unset otherwise. ---
# Read by scripts/hr-db-apply.mjs, never by the browser. Contains a password:
# share only through a password manager, never in chat, email or Git.
# HR_DEV_DATABASE_URL=
