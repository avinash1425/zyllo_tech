# dependencies (reinstalled from package-lock.json with `npm install`)
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output / caches
/dist
/build
/coverage
/.vite
*.tsbuildinfo

# env: secrets and local overrides stay out of Git.
# `.env` (browser-safe VITE_ values only) and `.env.example` ARE committed.
.env.local
.env.*.local
.env.development.local
.env.production.local

# Supabase CLI local state (project link, versions)
supabase/.temp/
supabase/.branches/

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel

# leftovers from the old Next.js version
/.next/
/out/
next-env.d.ts
